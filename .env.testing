# ใช้สำหรับรันคำสั่ง artisan ในโหมดทดสอบเท่านั้น
# บังคับให้เป็น SQLite เสมอ เพื่อไม่ให้คำสั่งอย่าง migrate:fresh ไปลบตารางในฐานข้อมูลจริง
APP_ENV=testing
APP_KEY=base64:Jui/Q99DsbaF5P3svAtjvfLWDuJ9wnEr+OJXpbjFm4M=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

BCRYPT_ROUNDS=4

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# ค่าจำลองสำหรับ Supabase Storage (ทดสอบเท่านั้น ไม่ต้องเป็นของจริง)
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=testing-anon-key
SUPABASE_SERVICE_ROLE_KEY=testing-service-role-key
SUPABASE_BUCKET=checkin-photos

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
